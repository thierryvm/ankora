# ============================================================================
# Ankora — Environment variables (EXAMPLE)
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill the values for your environment.
# NEVER commit `.env.local` or any file containing real secrets.
# ============================================================================

# ---------- App ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

# ---------- Design system playground ----------
# Set to "true" to enable /[locale]/_design-playground/ in production.
# In dev, the route is always accessible. In production, the page returns
# 404 unless this is "true". Server-only env (no NEXT_PUBLIC_ prefix) so
# the value cannot leak to the client bundle.
ANKORA_PLAYGROUND_ENABLED=false

# ---------- Admin RBAC ----------
# Comma-separated list of Supabase user IDs allowed in /admin/* routes.
# Initial PR-D4-PHASE2-B: only @thierry's user_id. Future RBAC may move
# to workspace_members.role-based check. Server-only.
ANKORA_ADMIN_USER_IDS=""

# ---------- Supabase ----------
# Get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only — NEVER expose this to the browser.
# Has admin access — bypasses RLS. Use only in trusted server contexts.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------- Upstash Redis (rate limiting) ----------
# Provision via Vercel Marketplace > Upstash
UPSTASH_REDIS_REST_URL="https://your-region.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ---------- Security ----------
# Used to sign audit log entries and other internal tokens.
# Generate with: openssl rand -base64 32
INTERNAL_SECRET="change-me-to-a-random-32-byte-string"

# Bearer token for the daily GDPR deletion cron (/api/cron/gdpr).
# Generate LOCALLY — never in a browser, never in a URL, never through an MCP
# tool: `openssl rand -base64 32`. Then paste it into the Vercel dashboard.
# Unset locally is fine: the route answers 401 to everything and logs an error.
CRON_SECRET="change-me-to-a-random-32-byte-string"

# ---------- Observability (optional in dev) ----------
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
